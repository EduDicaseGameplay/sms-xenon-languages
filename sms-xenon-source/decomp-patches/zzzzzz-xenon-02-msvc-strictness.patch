 	u16 local_2c;
 
+	static bool ukuleleFlag = 0; // above the switch: MSVC rejects a case that skips its initialisation
 	switch (param_2) {
 	case 15:
 		return MSGMSound->mTimerSyncValue;
@@ -288,7 +289,6 @@
 	}
 
 	case 120:
-		static bool ukuleleFlag = 0;
 		ukuleleFlag ^= true;
 		return ukuleleFlag;
 
