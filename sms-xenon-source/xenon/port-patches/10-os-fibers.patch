+extern "C" void* xe_fiber_current(void);
+bool g_fibers;
+void* g_dead_fiber; // an exited thread's fiber, deleted by the next one to run
+void reap_fiber()
+{
+	if (g_dead_fiber && g_dead_fiber != xe_fiber_current()) {
+		xe_fiber_delete(g_dead_fiber);
+		g_dead_fiber = NULL;
+	}
+}
+// a retired host's fiber (cancelled, or its thread object recreated): never switched to again
+void drop_fiber(struct Host* h);
+void fiber_entry(void* p); // an OSThread's first run
+#endif
