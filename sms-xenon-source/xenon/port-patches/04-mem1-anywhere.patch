Xbox 360: MEM1 cannot live at 0x80000000 (title image and kernel). It is an XPhysicalAlloc block anywhere, OS_BASE_CACHED/UNCACHED become its runtime base (no uncached mirror), GX gets the window, and JRenderer's texture/TLUT BP addresses use OSCachedToPhysical (the decomp's OSPhysicalToCached only worked by 2^32 wraparound with base 0x80000000). Applied by xenon/tools/xstage to the staged copy only.
diff -ru a/game/libs/dolphin/include/dolphin/os.h b/game/libs/dolphin/include/dolphin/os.h
--- a/game/libs/dolphin/include/dolphin/os.h	2026-10-24 09:32:50.453555819 +0500
+++ b/game/libs/dolphin/include/dolphin/os.h	2026-10-24 09:33:07.682326027 +0500
@@ -42,8 +42,16 @@
 #define OS_UNCACHED_REGION_PREFIX 0xC000
 #define OS_PHYSICAL_MASK          0x3FFF
 
+#ifdef _XBOX
+/* Xbox 360: MEM1 is wherever XPhysicalAlloc put it (platform/port_runtime.cpp), and there is no
+ * uncached mirror: both views are the one block. */
+extern u32 xe_mem1_base;
+#define OS_BASE_CACHED   xe_mem1_base
+#define OS_BASE_UNCACHED xe_mem1_base
+#else
 #define OS_BASE_CACHED   (OS_CACHED_REGION_PREFIX << 16)
 #define OS_BASE_UNCACHED (OS_UNCACHED_REGION_PREFIX << 16)
+#endif
 
 typedef struct BI2Debug {
 	/* 0x00 */ s32 debugMonSize;
