+}
+#define ga g_api
+#define writeBP xeApiBP
+#define writeCP xeApiCP
+#define writeXF xeApiXF
+#define flushBatch xeApiFlush
+#define callDisplayList xeApiCallDisplayList
+#define peekColor xeApiPeekColor
+#define peekZ xeApiPeekZ
+#define pixMetricClear xeApiPixMetricClear
+#define pixMetricRead xeApiPixMetricRead
+#define textureInvalidateAll xeApiTextureInvalidateAll
+#define resetState xeApiResetState
+#define XE_API_ALWAYS true  // the SDK writes what a call set, whatever a display list did since
+#else
+#define ga g
+#define XE_API_ALWAYS false
+#endif
